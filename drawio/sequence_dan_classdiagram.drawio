        <mxCell id="BKlm-dyXZhEMjYtBQmnI-368" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=23;" value="&lt;b&gt;&lt;i&gt;Sequence &lt;/i&gt;&lt;/b&gt;- Sistem Pelanggaran Siswa" vertex="1">
          <mxGeometry height="30" width="450" x="443" y="119" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass t_users {\n    +int id PK\n    +varchar name\n    +varchar email\n    +varchar password\n    +enum role\n}\n\nclass t_guru {\n    +int id PK\n    +varchar nip\n    +varchar nama\n    +varchar email\n    +tinyint status_aktif\n    +int user_id FK\n    +datetime created_at\n    +datetime updated_at\n}\n\nclass t_siswa {\n    +int id PK\n    +varchar nis\n    +varchar nisn\n    +varchar nama\n    +enum jenis_kelamin\n    +date tanggal_lahir\n    +text alamat\n    +tinyint status_aktif\n}\n\nclass t_kelas {\n    +int id PK\n    +varchar nama\n    +tinyint status_aktif\n}\n\nclass t_tahun_ajaran {\n    +int id PK\n    +varchar nama\n    +date tanggal_mulai\n    +date tanggal_selesai\n    +tinyint status_aktif\n}\n\nclass t_kelas_siswa {\n    +int siswa_id PK, FK\n    +int tahun_ajaran_id PK, FK\n    +int kelas_id PK, FK\n    +date tanggal_mulai\n    +date tanggal_selesai\n    +tinyint status_aktif\n}\n\nclass t_wali_kelas {\n    +int id PK\n    +int tahun_ajaran_id FK\n    +int kelas_id FK\n    +int guru_id FK\n    +date tanggal_mulai\n    +date tanggal_selesai\n    +tinyint status_aktif\n    +datetime created_at\n    +datetime updated_at\n}\n\nclass t_pelanggaran_kategori {\n    +int id PK\n    +varchar nama\n    +text deskripsi\n    +tinyint status_aktif\n    +datetime created_at\n    +datetime updated_at\n}\n\nclass t_pelanggaran {\n    +int id PK\n    +int pelanggaran_kategori_id FK\n    +varchar kode\n    +varchar nama\n    +int poin\n    +text deskripsi\n    +tinyint status_aktif\n    +datetime created_at\n    +datetime updated_at\n}\n\nclass t_pelanggaran_siswa {\n    +int id PK\n    +int tahun_ajaran_id FK\n    +int siswa_id FK\n    +varchar nama_siswa\n    +int kelas_id FK\n    +varchar nama_kelas\n    +int pelanggaran_id FK\n    +varchar nama_pelanggaran\n    +int pelanggaran_kategori_id FK\n    +int guru_id FK\n    +varchar nama_guru\n    +date tanggal\n    +text keterangan\n    +int poin\n    +text tindakan\n    +varchar status\n    +datetime created_at\n    +datetime updated_at\n}\n\nt_users \&quot;1\&quot; --&gt; \&quot;0..1\&quot; t_guru : memiliki akun\n\nt_siswa \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_kelas_siswa : ditempatkan\nt_kelas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_kelas_siswa : memiliki siswa\nt_tahun_ajaran \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_kelas_siswa : periode\n\nt_guru \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_wali_kelas : menjadi wali\nt_kelas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_wali_kelas : memiliki wali\nt_tahun_ajaran \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_wali_kelas : periode\n\nt_pelanggaran_kategori \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran : memiliki jenis\n\nt_tahun_ajaran \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : periode\nt_siswa \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : melakukan\nt_kelas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : kelas\nt_pelanggaran \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : dicatat\nt_pelanggaran_kategori \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : kategori\nt_guru \&quot;1\&quot; --&gt; \&quot;0..*\&quot; t_pelanggaran_siswa : mencatat&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="BKlm-dyXZhEMjYtBQmnI-369">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
