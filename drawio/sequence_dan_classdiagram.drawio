        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    T[\&quot;3. Sequence Diagram – Sistem Pelanggaran Siswa\&quot;]\n\n    subgraph R1[\&quot; \&quot;]\n    direction LR\n\n    subgraph A[\&quot;1. Login\&quot;]\n    direction LR\n    A1[\&quot;Pengguna\&quot;] --&gt; A2[\&quot;Halaman Login\&quot;] --&gt; A3[\&quot;Proses Login\&quot;] --&gt; A4[(\&quot;Database&lt;br/&gt;t_users\&quot;)]\n    A4 -. \&quot;data user\&quot; .-&gt; A3\n    A3 -. \&quot;verifikasi\&quot; .-&gt; A2\n    A2 -. \&quot;tampil dashboard\&quot; .-&gt; A1\n    end\n\n    subgraph B[\&quot;2. Kelola Siswa\&quot;]\n    direction LR\n    B1[\&quot;Admin\&quot;] --&gt; B2[\&quot;Halaman&lt;br/&gt;Kelola Siswa\&quot;] --&gt; B3[\&quot;Proses Siswa\&quot;] --&gt; B4[(\&quot;Database&lt;br/&gt;t_siswa\&quot;)]\n    B4 -. \&quot;data siswa\&quot; .-&gt; B3\n    B3 -. \&quot;tampilkan data\&quot; .-&gt; B2\n    B2 --&gt;|\&quot;tambah/edit/hapus\&quot;| B3\n    B3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| B4\n    B4 -. \&quot;hasil proses\&quot; .-&gt; B3\n    B3 -. \&quot;tampilkan pesan\&quot; .-&gt; B2\n    end\n\n    subgraph C[\&quot;3. Kelola Guru\&quot;]\n    direction LR\n    C1[\&quot;Admin\&quot;] --&gt; C2[\&quot;Halaman&lt;br/&gt;Kelola Guru\&quot;] --&gt; C3[\&quot;Proses Guru\&quot;] --&gt; C4[(\&quot;Database&lt;br/&gt;t_guru\&quot;)]\n    C4 -. \&quot;data guru\&quot; .-&gt; C3\n    C3 -. \&quot;tampilkan data\&quot; .-&gt; C2\n    C2 --&gt;|\&quot;tambah/edit/hapus\&quot;| C3\n    C3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| C4\n    C4 -. \&quot;hasil proses\&quot; .-&gt; C3\n    C3 -. \&quot;tampilkan pesan\&quot; .-&gt; C2\n    end\n\n    end\n\n    subgraph R2[\&quot; \&quot;]\n    direction LR\n\n    subgraph D[\&quot;4. Kelola Kelas\&quot;]\n    direction LR\n    D1[\&quot;Admin\&quot;] --&gt; D2[\&quot;Halaman&lt;br/&gt;Kelola Kelas\&quot;] --&gt; D3[\&quot;Proses Kelas\&quot;] --&gt; D4[(\&quot;Database&lt;br/&gt;t_kelas\&quot;)]\n    D4 -. \&quot;data kelas\&quot; .-&gt; D3\n    D3 -. \&quot;tampilkan data\&quot; .-&gt; D2\n    D2 --&gt;|\&quot;tambah/edit/hapus\&quot;| D3\n    D3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| D4\n    D4 -. \&quot;hasil proses\&quot; .-&gt; D3\n    D3 -. \&quot;tampilkan pesan\&quot; .-&gt; D2\n    end\n\n    subgraph E[\&quot;5. Kelola Tahun Ajaran\&quot;]\n    direction LR\n    E1[\&quot;Admin\&quot;] --&gt; E2[\&quot;Halaman&lt;br/&gt;Tahun Ajaran\&quot;] --&gt; E3[\&quot;Proses Tahun Ajaran\&quot;] --&gt; E4[(\&quot;Database&lt;br/&gt;t_tahun_ajaran\&quot;)]\n    E4 -. \&quot;data tahun ajaran\&quot; .-&gt; E3\n    E3 -. \&quot;tampilkan data\&quot; .-&gt; E2\n    E2 --&gt;|\&quot;tambah/edit/hapus\&quot;| E3\n    E3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| E4\n    E4 -. \&quot;hasil proses\&quot; .-&gt; E3\n    E3 -. \&quot;tampilkan pesan\&quot; .-&gt; E2\n    end\n\n    subgraph F[\&quot;6. Penempatan Siswa\&quot;]\n    direction LR\n    F1[\&quot;Admin\&quot;] --&gt; F2[\&quot;Halaman&lt;br/&gt;Penempatan\&quot;] --&gt; F3[\&quot;Proses Penempatan\&quot;] --&gt; F4[(\&quot;Database&lt;br/&gt;t_kelas_siswa\&quot;)]\n    F4 -. \&quot;data penempatan\&quot; .-&gt; F3\n    F3 -. \&quot;tampilkan data\&quot; .-&gt; F2\n    F2 --&gt;|\&quot;tambah/edit/hapus\&quot;| F3\n    F3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| F4\n    F4 -. \&quot;hasil proses\&quot; .-&gt; F3\n    F3 -. \&quot;tampilkan pesan\&quot; .-&gt; F2\n    end\n\n    end\n\n    subgraph R3[\&quot; \&quot;]\n    direction LR\n\n    subgraph G[\&quot;7. Kategori Pelanggaran\&quot;]\n    direction LR\n    G1[\&quot;Admin\&quot;] --&gt; G2[\&quot;Halaman&lt;br/&gt;Kategori\&quot;] --&gt; G3[\&quot;Proses Kategori\&quot;] --&gt; G4[(\&quot;Database&lt;br/&gt;t_pelanggaran_kategori\&quot;)]\n    G4 -. \&quot;data kategori\&quot; .-&gt; G3\n    G3 -. \&quot;tampilkan data\&quot; .-&gt; G2\n    G2 --&gt;|\&quot;tambah/edit/hapus\&quot;| G3\n    G3 --&gt;|\&quot;simpan/ubah/hapus\&quot;| G4\n    G4 -. \&quot;hasil pro